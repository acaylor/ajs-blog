# WireGuard on an Ubuntu VM (example addresses). Render with:
#   d2 --layout elk --pad 40 wireguard-ubuntu-vm.d2 wireguard-ubuntu-vm.svg

direction: down

# Readable at blog column width (~800px): large text everywhere.
(** -> **)[*].style.font-size: 20

classes: {
  host: {
    shape: rectangle
    style: {
      font-size: 22
      fill: "#fff8e8"
      stroke: "#3b3428"
      stroke-width: 2
    }
  }
  part: {
    shape: rectangle
    style: {
      fill: "#ffffff"
      stroke: "#3b3428"
      stroke-width: 1
      font-size: 20
    }
  }
  endpoint: {
    shape: rectangle
    style: {
      font-size: 22
      fill: "#f7f7f7"
      stroke: "#555555"
      stroke-dash: 4
    }
  }
  zone: {
    style: {
      font-size: 24
      fill: "#fcfaf5"
      stroke: "#8a5300"
      stroke-width: 2
    }
  }
}

client: "VPN client (phone, laptop)\nAddress 10.8.0.2/32 · DNS 10.8.0.1" {class: endpoint; width: 520}
dns_pub: "Public DNS\nvpn.example.com → home IP" {class: endpoint}
router: "Home router\nport forward\nUDP 51820 → 192.168.10.6" {class: host}

lan: "LAN 192.168.10.0/24" {
  class: zone

  vm: "Ubuntu 26.04 VM (192.168.10.6)" {
    class: host
    wg: "wg0 (wg-quick@wg0)\n10.8.0.1/24, UDP 51820" {class: part}
    resolved: "systemd-resolved\nDNSStubListenerExtra=10.8.0.1" {class: part}
    nat: "iptables FORWARD +\nMASQUERADE out eth0" {class: part}
  }

  adguard: "LAN DNS\n192.168.10.53, .54" {class: host}
  services: "LAN services\n(web apps, SSH, ...)" {class: host}
}

client -> dns_pub: "1. look up\nendpoint" {style.stroke-dash: 3}
client -> router: "2. encrypted\nUDP 51820"
router -> lan.vm.wg
lan.vm.wg -> lan.vm.resolved: "DNS queries to 10.8.0.1"
lan.vm.resolved -> lan.adguard: "forward"
lan.vm.wg -> lan.vm.nat: "decrypted traffic"
lan.vm.nat -> lan.services: "source rewritten\nto 192.168.10.6"
