---
import BaseLayout from './BaseLayout.astro';
import Banner from '../components/Banner.astro';
import Prompt from '../components/Prompt.astro';
import ShareButtons from '../components/ShareButtons.astro';
import TableOfContents from '../components/TableOfContents.astro';
import CopyCode from '../components/CopyCode.astro';
import { slugify } from '../utils/slug';

interface AdjacentPost {
  title: string;
  href: string;
}

interface Props {
  title: string;
  date: Date;
  description?: string;
  author?: string;
  tags?: string[];
  categories?: string[];
  readingTime: string;
  wordCount?: number;
  image?: string;
  headings: { depth: number; slug: string; text: string }[];
  updated?: Date;
  postId: string;
  prev?: AdjacentPost;
  next?: AdjacentPost;
}

const {
  title,
  date,
  description,
  author,
  tags = [],
  categories = [],
  readingTime,
  wordCount,
  image,
  headings,
  updated,
  postId,
  prev,
  next,
} = Astro.props;

const isoDate = date.toISOString();
const ymd = isoDate.slice(0, 10);
const updatedYmd = updated?.toISOString().slice(0, 10);

const wordsText = wordCount
  ? `${wordCount >= 1000 ? `${(wordCount / 1000).toFixed(1)}k` : wordCount} words`
  : null;

// Banner status lines state real facts about the post. [WARN] fires when the
// post hasn't been touched in over two years (as of the build), because
// commands and versions in older homelab posts do go stale.
const STALE_YEARS = 2;
const lastTouched = updated ?? date;
const isStale = Date.now() - lastTouched.valueOf() > STALE_YEARS * 365.25 * 86_400_000;
const bannerLines = [
  { tag: 'ok' as const, text: [wordsText, readingTime, ymd].filter(Boolean).join(' · ') },
  ...(updatedYmd ? [{ tag: 'note' as const, text: `updated ${updatedYmd}` }] : []),
  ...(isStale
    ? [
        {
          tag: 'warn' as const,
          text: `last touched ${lastTouched.toISOString().slice(0, 10)}, over ${STALE_YEARS} years ago; commands and versions may be stale`,
        },
      ]
    : []),
];

const pageUrl = new URL(Astro.url.pathname, Astro.site ?? 'https://blog.ayjc.net').toString();
---

<BaseLayout title={title} description={description} mainClass="post">
  <article>
    <Banner command={`cat /posts/${postId}.md`} lines={bannerLines} />

    <div class="post-meta">
      <time datetime={isoDate}>{ymd}</time>
      <span>{readingTime}</span>
      {
        author && (
          <>
            <span>by {author}</span>
          </>
        )
      }
      {
        categories.length > 0 && (
          <>
            <span>
              {categories.map((cat, i) => (
                <>
                  {i > 0 && ' / '}
                  <a href={`/categories/${slugify(cat)}/`} class="cat">
                    {cat}
                  </a>
                </>
              ))}
            </span>
          </>
        )
      }
      {
        updatedYmd && (
          <>
            <span>updated {updatedYmd}</span>
          </>
        )
      }
    </div>

    <h1 class="post-title">{title}</h1>

    {
      tags.length > 0 && (
        <div class="post-tags-row">
          {tags.map((tag) => (
            <a href={`/tags/${slugify(tag)}/`} class="tag-link" set:text={slugify(tag)} />
          ))}
        </div>
      )
    }

    {
      image && (
        <figure class="figure hero">
          <img src={image} alt="" loading="lazy" />
        </figure>
      )
    }

    <div class="prose">
      <slot />
    </div>

    <ShareButtons title={title} url={pageUrl} />

    {
      (prev || next) && (
        <nav class="navnext" aria-label="Adjacent posts">
          {prev ? (
            <a href={prev.href}>
              <span class="dir" aria-hidden="true">
                &larr; prev
              </span>
              {prev.title}
            </a>
          ) : (
            <span />
          )}
          {next ? (
            <a href={next.href} class="next">
              <span class="dir" aria-hidden="true">
                next &rarr;
              </span>
              {next.title}
            </a>
          ) : (
            <span />
          )}
        </nav>
      )
    }

    <Prompt />
  </article>

  <TableOfContents headings={headings} />
  <CopyCode />
</BaseLayout>
