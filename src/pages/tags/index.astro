---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Banner from '../../components/Banner.astro';
import Prompt from '../../components/Prompt.astro';
import { getCollection } from 'astro:content';
import { groupBySlug } from '../../utils/taxonomy';
import { getBlogStats } from '../../utils/blog-stats';
import { buildClock } from '../../utils/build-info';

const posts = await getCollection('blog', ({ data }) => !data.draft);

// Case-duplicate tags collapse into a single row because they now share one slug
// (Decision 4 in REFACTOR.md). `macOS` and `macos` are one route, so the count shown
// here is the real number of posts behind the link rather than the dominant spelling's
// share of them.
const tags = groupBySlug(posts, 'tags').map((group) => ({
  slug: group.slug,
  display: group.display,
  count: group.posts.length,
}));

const totalTagged = tags.reduce((sum, t) => sum + t.count, 0);
const maxCount = tags[0]?.count ?? 1;
const longTailThreshold = 5;
const longTail = tags.filter((t) => t.count < longTailThreshold).length;

// `top` header, every figure real. Load average is posts per month averaged
// over the last 1, 5 and 15 months (top's 1/5/15-minute windows, scaled).
// "running" tags were used by a post in the last 30 days, as of the build.
const { uptimeDays } = await getBlogStats();
const MONTH = 30.44 * 86_400_000;
const now = Date.now();
const load = [1, 5, 15].map(
  (m) => posts.filter((p) => now - p.data.date.valueOf() < m * MONTH).length / m,
);
const runningSlugs = new Set(
  groupBySlug(
    posts.filter((p) => now - p.data.date.valueOf() < 30 * 86_400_000),
    'tags',
  ).map((g) => g.slug),
);
const running = tags.filter((t) => runningSlugs.has(t.slug)).length;
const clock = buildClock.split(' ')[0];
// "users" are distinct post authors (posts without one are the site owner's).
const users = new Set(posts.map((p) => p.data.author ?? 'aj')).size;
---

<BaseLayout title="Tags">
  <Banner
    command="sort -k2 -rn /var/blog/tags.tsv"
    status={{
      tag: 'info',
      label: '[INFO]',
      text: `${tags.length} tags · ${totalTagged} tag-uses · sorted by count desc`,
    }}
  />

  <h1 class="title">tags</h1>

  <pre
    class="top-head">top - {clock} up {uptimeDays} days,  {users} {users === 1 ? 'user' : 'users'},  load average: <span title="posts per month, averaged over the last 1, 5 and 15 months">{
        load.map((l) => l.toFixed(2)).join(', ')
      }</span>
Tags: {tags.length} total, <span title="used by a post in the last 30 days">{running} running</span>, {
      tags.length - running
    } sleeping
Refs: {totalTagged} total, {(totalTagged / posts.length).toFixed(1)} per post</pre>

  <table class="stat" aria-label="Tag frequency">
    <thead>
      <tr>
        <th scope="col">tag</th>
        <th scope="col" class="bar">usage</th>
        <th scope="col">count</th>
        <th scope="col">%</th>
      </tr>
    </thead>
    <tbody>
      {
        tags.map(({ slug, display, count }) => {
          const pct = (count / totalTagged) * 100;
          const barPct = (count / maxCount) * 100;
          return (
            <tr>
              <td class="name">
                <a href={`/tags/${slug}/`}>{display}</a>
              </td>
              <td class="bar">
                <span class="bar-track" aria-hidden="true">
                  <span class="bar-fill" style={`width: ${barPct.toFixed(1)}%`} />
                </span>
              </td>
              <td class="count">{count}</td>
              <td class="pct">{pct.toFixed(1)}%</td>
            </tr>
          );
        })
      }
    </tbody>
  </table>

  {
    longTail > 0 && (
      <p class="log" style="margin-top: 1rem">
        <span class="tag-note">[NOTE]</span> {longTail} tags appear in fewer than{' '}
        {longTailThreshold} posts &middot; consider consolidating before they fragment further.
      </p>
    )
  }

  <Prompt />
</BaseLayout>
