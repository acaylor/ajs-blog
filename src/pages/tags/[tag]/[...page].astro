---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Banner from '../../../components/Banner.astro';
import Module from '../../../components/Module.astro';
import JournalList from '../../../components/JournalList.astro';
import Pagination from '../../../components/Pagination.astro';
import Prompt from '../../../components/Prompt.astro';
import { getCollection } from 'astro:content';
import { journalSummary } from '../../../utils/journal';
import { groupBySlug } from '../../../utils/taxonomy';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return groupBySlug(posts, 'tags').flatMap((group) =>
    paginate(group.posts, {
      params: { tag: group.slug },
      props: { display: group.display, journal: journalSummary(group.posts) },
      pageSize: 12,
    }),
  );
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { page, display, journal } = Astro.props;
const moduleName = `entries ${page.start + 1}–${page.end + 1}`;
const pageLabel = `page ${page.currentPage}/${page.lastPage}`;
const basePath = `/tags/${tag}`;
---

<BaseLayout
  title={page.currentPage > 1 ? `tag: ${display} - Page ${page.currentPage}` : `tag: ${display}`}
>
  <Banner
    command={`grep -l "tag:${display}" /posts/*.md`}
    status={{
      tag: 'info',
      label: '[INFO]',
      text: `${page.total} entries · ${pageLabel} · sorted by date desc`,
    }}
  />

  <h1 class="title">tag: {display}</h1>
  <p class="title-sub">
    <a href="/tags/">&larr; all tags</a>
  </p>

  <Module name={moduleName} count={`of ${page.total}`} />

  <JournalList posts={page.data} journal={journal} />

  <Pagination currentPage={page.currentPage} lastPage={page.lastPage} basePath={basePath} />

  <Prompt />
</BaseLayout>
