---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Banner from '../../../components/Banner.astro';
import Module from '../../../components/Module.astro';
import PostEntry from '../../../components/PostEntry.astro';
import Pagination from '../../../components/Pagination.astro';
import Prompt from '../../../components/Prompt.astro';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../../../utils/reading-time';
import { groupBySlug } from '../../../utils/taxonomy';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = await getCollection('blog', ({ data }) => !data.draft);

  return groupBySlug(posts, 'tags').flatMap((group) =>
    paginate(group.posts, {
      params: { tag: group.slug },
      props: { display: group.display },
      pageSize: 12,
    }),
  );
}) satisfies GetStaticPaths;

const { tag } = Astro.params;
const { page, display } = Astro.props;
const moduleName = `page_${String(page.currentPage).padStart(3, '0')}`;
const pageLabel = `page ${page.currentPage}/${page.lastPage}`;
const basePath = `/tags/${tag}`;
---

<BaseLayout
  title={page.currentPage > 1 ? `tag: ${display} - Page ${page.currentPage}` : `tag: ${display}`}
>
  <Banner
    command={`grep -l "tag:${display}" /posts/*.md`}
    status={{
      tag: 'info',
      label: '[INFO]',
      text: `${page.total} entries · ${pageLabel} · sorted by date desc`,
    }}
  />

  <h1 class="title">tag: {display}</h1>
  <p class="title-sub">
    <a href="/tags/">&larr; all tags</a>
  </p>

  <Module name={moduleName} />

  {
    page.data.map((post) => (
      <PostEntry
        title={post.data.title}
        date={post.data.date}
        href={`/posts/${post.id}/`}
        readingTime={getReadingTime(post.body || '')}
        tags={post.data.tags}
      />
    ))
  }

  <Pagination currentPage={page.currentPage} lastPage={page.lastPage} basePath={basePath} />

  <Prompt />
</BaseLayout>
