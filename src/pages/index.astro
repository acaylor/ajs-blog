---
import BaseLayout from '../layouts/BaseLayout.astro';
import Banner from '../components/Banner.astro';
import Module from '../components/Module.astro';
import PostCard from '../components/PostCard.astro';
import Prompt from '../components/Prompt.astro';
import { getCollection } from 'astro:content';
import { getReadingTime } from '../utils/reading-time';
import { groupBySlug } from '../utils/taxonomy';

const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const recent = posts.slice(0, 6);
const totalPosts = posts.length;

// Every boot line reports a real figure computed from the collection.
const totalWords = posts.reduce((sum, p) => sum + (p.body ?? '').trim().split(/\s+/).length, 0);
const tags = groupBySlug(posts, 'tags');
const tagRefs = tags.reduce((sum, t) => sum + t.posts.length, 0);
const categoryCount = groupBySlug(posts, 'categories').length;
const latest = posts[0];
const kWords = `${Math.round(totalWords / 1000)}k`;

const bootLines = [
  { text: `mounting /posts: ${totalPosts} entries, ${kWords} words` },
  { text: `loading taxonomy: ${tags.length} tags (${tagRefs} refs), ${categoryCount} categories` },
  {
    text: `last write: ${latest.data.date.toISOString().slice(0, 10)} /posts/${latest.id}.md`,
  },
];

// Boot reveal timing: the banner streams its rows at 110ms each (see patterns.css),
// then the rest of the page arrives in quicker steps.
const bannerRows = 2 + bootLines.length + 1;
const step = (n: number) => `${bannerRows * 110 + n * 70}ms`;
---

<BaseLayout title="Home">
  <Banner
    command="cat /"
    lines={bootLines}
    status={{ tag: 'ok', text: 'reached target blog.target' }}
  />

  <h1 class="hero boot-step" style={`--d: ${step(0)}`}>aj's blog</h1>
  <p class="hero-sub boot-step" style={`--d: ${step(1)}`}>
    A personal blog focused on software, technology, and the cloud. Sharing what I'm working with at
    home — what broke, what stayed up, and what I learned getting it there.
  </p>

  <div class="boot-step" style={`--d: ${step(2)}`}>
    <Module name="recent" count={`${recent.length}/${totalPosts}`} />
  </div>

  {
    recent.map((post, i) => (
      <PostCard
        title={post.data.title}
        date={post.data.date}
        updated={post.data.updated}
        description={post.data.description}
        tags={post.data.tags}
        categories={post.data.categories}
        image={post.data.image}
        readingTime={getReadingTime(post.body || '')}
        href={`/posts/${post.id}/`}
        bootDelay={step(3 + i)}
      />
    ))
  }

  <p class="log more boot-step" style={`--d: ${step(3 + recent.length)}`}>
    {recent.length} of {totalPosts} post units listed. Pass <a href="/posts/">--all</a> to see the rest,
    or follow <a href="/rss.xml">/rss.xml</a>.
  </p>

  <Prompt />
</BaseLayout>
