---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Banner from '../../components/Banner.astro';
import Prompt from '../../components/Prompt.astro';
import { getCollection } from 'astro:content';
import { groupBySlug } from '../../utils/taxonomy';

const posts = await getCollection('blog', ({ data }) => !data.draft);

const categories = groupBySlug(posts, 'categories').map((group) => ({
  slug: group.slug,
  name: group.display,
  count: group.posts.length,
}));

const maxCount = categories[0]?.count ?? 1;
---

<BaseLayout title="Categories">
  <Banner
    command="df -h /categories"
    status={{
      tag: 'info',
      text: `${categories.length} filesystems · sorted by size desc`,
    }}
  />

  <h1 class="title">categories</h1>

  {
    /* df -h: size = posts in the category; use% = share of all posts carrying it
      (a post can sit in two categories, so the column doesn't sum to 100). */
  }
  <table class="stat df" aria-label="Categories by post count">
    <thead>
      <tr>
        <th scope="col">filesystem</th>
        <th scope="col" class="num">size</th>
        <th scope="col" class="bar"></th>
        <th scope="col" class="pct">use%</th>
        <th scope="col" class="mnt">mounted on</th>
      </tr>
    </thead>
    <tbody>
      {
        categories.map(({ slug, name, count }) => {
          const use = (count / posts.length) * 100;
          const barPct = (count / maxCount) * 100;
          return (
            <tr>
              <td class="fs name">
                <a href={`/categories/${slug}/`}>{name}</a>
              </td>
              <td class="count num">{count}</td>
              <td class="bar">
                <span class="bar-track" aria-hidden="true">
                  <span class="bar-fill" style={`width: ${barPct.toFixed(1)}%`} />
                </span>
              </td>
              <td class="pct">{Math.round(use)}%</td>
              <td class="mnt">/categories/{slug}/</td>
            </tr>
          );
        })
      }
    </tbody>
  </table>

  <Prompt />
</BaseLayout>
