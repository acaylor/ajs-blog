---
import type { GetStaticPaths } from 'astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Banner from '../../components/Banner.astro';
import Module from '../../components/Module.astro';
import JournalList from '../../components/JournalList.astro';
import Pagination from '../../components/Pagination.astro';
import Prompt from '../../components/Prompt.astro';
import { getCollection } from 'astro:content';
import { journalSummary } from '../../utils/journal';

export const getStaticPaths = (async ({ paginate }) => {
  const posts = (await getCollection('blog', ({ data }) => !data.draft)).sort(
    (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
  );
  return paginate(posts, { pageSize: 12, props: { journal: journalSummary(posts) } });
}) satisfies GetStaticPaths;

const { page, journal } = Astro.props;
const moduleName = `entries ${page.start + 1}–${page.end + 1}`;
const pageLabel = `page ${page.currentPage}/${page.lastPage}`;
---

<BaseLayout title={page.currentPage > 1 ? `Posts - Page ${page.currentPage}` : 'Posts'}>
  <Banner
    command="journalctl /posts --reverse --limit 12"
    status={{
      tag: 'info',
      label: '[INFO]',
      text: `${page.total} entries · ${pageLabel} · sorted by date desc`,
    }}
  />

  <h1 class="title">posts</h1>

  <Module name={moduleName} count={`of ${page.total}`} />

  <JournalList posts={page.data} journal={journal} />

  <Pagination currentPage={page.currentPage} lastPage={page.lastPage} basePath="/posts" />

  <Prompt />
</BaseLayout>
