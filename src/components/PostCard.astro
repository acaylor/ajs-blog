---
import { slugify } from '../utils/slug';

interface Props {
  title: string;
  date: Date;
  description?: string;
  tags?: string[];
  readingTime: string;
  href: string;
  image?: string;
  categories?: string[];
}

const {
  title,
  date,
  description,
  tags = [],
  readingTime,
  href,
  image,
  categories = [],
} = Astro.props;

const isoDate = date.toISOString();
const ymd = isoDate.slice(0, 10);
const metaCategory = categories.slice(0, 2).join(' / ');
const metaParts = [readingTime, metaCategory].filter(Boolean);
---

<div class="unit" class:list={[{ 'has-thumb': Boolean(image) }]}>
  <div class="unit-body">
    <div class="head">
      <span class="name"><a href={href}>{title}</a></span>
    </div>
    <div class="meta">
      <time datetime={isoDate}>{ymd}</time>
      {metaParts.map((part) => <span>{part}</span>)}
    </div>
    {description && <div class="desc">{description}</div>}
    {
      tags.length > 0 && (
        <div class="tags">
          {tags.slice(0, 4).map((tag) => (
            <a href={`/tags/${slugify(tag)}/`} class="tag-link" set:text={slugify(tag)} />
          ))}
        </div>
      )
    }
  </div>
  {
    image && (
      <a class="thumb" href={href} tabindex="-1" aria-hidden="true">
        <img src={image} alt="" loading="lazy" width="88" height="88" />
      </a>
    )
  }
</div>
