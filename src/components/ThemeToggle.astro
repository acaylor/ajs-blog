---
// Text button in the tmux status line, labelled with vim's command for switching
// background (`:set bg=dark`). Label shows the theme a click switches to.
// Pre-paint script in BaseLayout sets data-theme before this renders.
//
// The site follows the system color scheme. A click stores an override in
// localStorage, but only when it differs from the system; clicking back to the
// system's theme clears it. Any system change wins and clears the override.
---

<button id="theme-toggle" type="button" class="toggle" aria-label="Toggle color theme"
  ><span class="set">:set </span>bg=<span class="val">dark</span></button
>

<script is:inline>
  (function () {
    var media = window.matchMedia('(prefers-color-scheme: dark)');

    function system() {
      return media.matches ? 'dark' : 'light';
    }

    function store(t) {
      try {
        if (t) localStorage.setItem('theme', t);
        else localStorage.removeItem('theme');
      } catch {
        // storage blocked: the override lasts until the page unloads
      }
    }

    function syncLabel() {
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      var cur = document.documentElement.getAttribute('data-theme') || 'light';
      btn.querySelector('.val').textContent = cur === 'dark' ? 'light' : 'dark';
    }

    function apply(t) {
      document.documentElement.setAttribute('data-theme', t);
      syncLabel();
    }

    document.addEventListener('DOMContentLoaded', function () {
      syncLabel();
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var next =
          document.documentElement.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
        store(next === system() ? null : next);
        apply(next);
      });
    });

    media.addEventListener('change', function () {
      store(null);
      apply(system());
    });

    // Keep other open tabs in step with a toggle or a cleared override.
    window.addEventListener('storage', function (e) {
      if (e.key === 'theme') apply(e.newValue || system());
    });
  })();
</script>
