---
// Text button in the tmux status line, labelled with vim's command for switching
// background (`:set bg=dark`). Label shows the theme a click switches to.
// Pre-paint script in BaseLayout sets data-theme before this renders.
---

<button id="theme-toggle" type="button" class="toggle" aria-label="Toggle color theme"
  ><span class="set">:set </span>bg=<span class="val">dark</span></button
>

<script is:inline>
  (function () {
    function syncLabel() {
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      var cur = document.documentElement.getAttribute('data-theme') || 'light';
      btn.querySelector('.val').textContent = cur === 'dark' ? 'light' : 'dark';
    }

    function setTheme(t) {
      document.documentElement.setAttribute('data-theme', t);
      localStorage.setItem('theme', t);
      syncLabel();
    }

    document.addEventListener('DOMContentLoaded', function () {
      syncLabel();
      var btn = document.getElementById('theme-toggle');
      if (!btn) return;
      btn.addEventListener('click', function () {
        var cur = document.documentElement.getAttribute('data-theme');
        setTheme(cur === 'dark' ? 'light' : 'dark');
      });
    });

    window.matchMedia('(prefers-color-scheme: dark)').addEventListener('change', function (e) {
      if (!localStorage.getItem('theme')) {
        document.documentElement.setAttribute('data-theme', e.matches ? 'dark' : 'light');
        syncLabel();
      }
    });
  })();
</script>
